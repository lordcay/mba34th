{
  "expo": {
    "name": "34thstreet",
    "slug": "34thstreet",
    "version": "1.1.7",
    "orientation": "portrait",
    "icon": "./assets/logo1.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/logo1.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "notification": {
      "icon": "./assets/logo1.png",
      "color": "#581845",
      "androidMode": "default",
      "androidCollapsedTitle": "34th Street"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.coredevhub.34thstreet",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSContactsUsageDescription": "We need access to your contacts to help you find and connect with friends on 34th Street.",
        "NSPhotoLibraryUsageDescription": "We need access to your photos so you can upload a profile picture.",
        "NSPhotoLibraryAddUsageDescription": "We may save edited photos to your library.",
        "NSCameraUsageDescription": "We need camera access for video calls and profile pictures.",
        "NSMicrophoneUsageDescription": "We need microphone access for voice and video calls.",
        "LSApplicationQueriesSchemes": [
          "linkedin"
        ],
        "UIBackgroundModes": [
          "fetch",
          "remote-notification",
          "voip",
          "audio"
        ]
      }
    },
    "android": {
      "package": "com.street.app",
      "versionCode": 2,
      "adaptiveIcon": {
        "foregroundImage": "./assets/logo1.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "softwareKeyboardLayoutMode": "resize",
      "useNextNotificationsApi": true,
      "permissions": [
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.VIBRATE",
        "android.permission.WAKE_LOCK",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.BLUETOOTH",
        "android.permission.BLUETOOTH_CONNECT"
      ]
    },
    "web": {
      "favicon": "./assets/logo1.png"
    },
    "plugins": [
      "expo-font",
      [
        "expo-notifications",
        {
          "icon": "./assets/logo1.png",
          "color": "#581845",
          "sounds": ["./assets/sounds/incoming.wav"],
          "defaultChannel": "messages",
          "enableBackgroundRemoteNotifications": true
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow 34thstreet to access your photos so you can upload a profile picture.",
          "cameraPermission": "Allow 34thstreet to access your camera to take a new profile picture."
        }
      ],
      [
        "@config-plugins/react-native-webrtc",
        {
          "cameraPermission": "Allow 34thstreet to access your camera for video calls.",
          "microphonePermission": "Allow 34thstreet to access your microphone for voice and video calls."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "5cc31987-a7a7-41aa-9925-8c33fe13f8af"
      }
    }
  }
}
